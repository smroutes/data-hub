# Copy to .env.local (Vite loads it automatically, and it's gitignored)
# to override for local dev. In production this is baked in at build time
# via the same variable in the frontend's build environment/CI.

# Base URL of the citizen-records stack's public gateway (../db) -- a
# separate app on its own droplet. Defaults to the local dev gateway port
# (see ../db/README.md "Local development") if unset.
VITE_CITIZENS_API_URL=http://localhost:8081
