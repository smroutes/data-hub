# The bare/apex domain is a separate static placeholder page, not the app --
# keeps it from looking broken while the real site for it is built elsewhere.
wb275.in, www.wb275.in {
	root * /srv-landing
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}

	header {
		-Server
	}
}

{$SITE_ADDRESS} {
	# No server-level redirect for "/" -- the React app's own root route
	# handles this client-side (see App.tsx), so it stays in sync with
	# route renames instead of needing this file updated too.

	handle /api/* {
		reverse_proxy backend:8000
	}

	# Auth and data for the citizen-records stack live on a separate droplet
	# (see ../db). Proxying them through this same origin keeps every browser
	# request under datahub.wb275.in instead of exposing api.wb275.in directly.
	handle /auth/* {
		reverse_proxy https://api.wb275.in {
			header_up Host api.wb275.in
		}
	}

	handle /rest/* {
		reverse_proxy https://api.wb275.in {
			header_up Host api.wb275.in
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
	}
}
