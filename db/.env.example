# Copy to .env and fill in real values. Never commit .env.
# Generate strong secrets with, e.g.:
#   openssl rand -base64 32
# (avoid characters like ' " \ in generated values -- they get embedded in SQL)

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=citizens
TZ=Asia/Kolkata

# Passwords for the internal roles PostgREST/GoTrue connect as
# (see postgres/init/01-roles.sql). Generate separately from
# POSTGRES_PASSWORD -- these are different roles.
AUTHENTICATOR_PASSWORD=
GOTRUE_DB_PASSWORD=

# --- Auth (GoTrue) ---
# Shared with PostgREST below -- must be identical in both places.
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXP=3600

# Not used for real email delivery (GOTRUE_MAILER_AUTOCONFIRM=true and
# admin-only user creation mean no mail is ever sent) -- just needs to be
# a syntactically valid URL. Set to your real domain once you put this
# behind a reverse proxy.
GOTRUE_SITE_URL=http://localhost

# --- Gateway (Caddy, public entrypoint into auth/rest) ---
# Real domain -> Caddy auto-provisions HTTPS. Leave unset for local dev.
SITE_ADDRESS=
# Origin of the frontend app calling this API (it lives in ../frontend, a
# separate app/droplet -- see README). Local dev default matches `npm run
# dev` in frontend/. Set to your real frontend domain in production.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Cloudflare R2 (backups) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# --- Backup retention ---
BACKUP_RETENTION_DAILY_DAYS=7
BACKUP_RETENTION_WEEKLY_DAYS=56
# Set to "true" to let scripts/backup.sh delete backups older than the
# retention above. Defaults to "false" (keep everything, no deletion).
BACKUP_PRUNE_ENABLED=false

# --- Admin bootstrap (scripts/create-admin.sh) ---
# "Username" is mapped to <value>@internal.local for GoTrue -- see README
# for why (GoTrue has no username-only auth mode).
ADMIN_USERNAME=admin
