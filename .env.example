# Public domain Caddy should serve and auto-provision HTTPS for, e.g. data.example.com
# Leave unset (defaults to ":80") to run HTTP-only, e.g. when testing against a bare IP.
SITE_ADDRESS=

# Cloudflare R2 (S3-compatible) source for each dataset's CSV, all in R2_BUCKET.
# Leave all blank to fall back to local CSVs under ./sheet-data (see docker-compose.yml).
R2_BUCKET=
R2_OBJECT_KEY_ANNAPURNA=
R2_OBJECT_KEY_BOOTH_PRESIDENT=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# AI Application Writer -- generating the actual application text.
# DeepSeek's API is OpenAI-compatible, so the official openai package is
# used unmodified against it. Leave blank to disable the feature (the
# endpoint returns 503 instead of erroring).
DEEPSEEK_API_KEY=
# Only needed to override the default (https://api.deepseek.com) or the
# default model (deepseek-chat).
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# AI Application Writer -- prompt auto-suggest. Separate (free-tier) Groq
# model since this fires much more often than a full generation and
# doesn't need DeepSeek's quality -- same OpenAI-compatible pattern.
GROQ_API_KEY=
# Only needed to override the default (https://api.groq.com/openai/v1) or
# the default model (openai/gpt-oss-20b -- see app/main.py's comments on
# why a reasoning model needs reasoning_effort="low" to stay fast here).
GROQ_BASE_URL=
GROQ_MODEL=
