# Public domain Caddy should serve and auto-provision HTTPS for, e.g. data.example.com
# Leave unset (defaults to ":80") to run HTTP-only, e.g. when testing against a bare IP.
SITE_ADDRESS=

# Cloudflare R2 (S3-compatible) source for the report CSV.
# Leave all blank to fall back to a local CSV mounted at ./sheet-data (see docker-compose.yml).
R2_BUCKET=
R2_OBJECT_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
